# Template for docker-compose.standalone.yaml.
# Copy it to .env in the repository root and replace every <...> value. Never commit the filled file.
#   cp deploy/standalone.env.example .env

# --- Application ---------------------------------------------------------
INSTALLATION_NAME=QEVA CRM
# Public URL. Use http://localhost:3000 on a local machine.
FRONTEND_URL=http://localhost:3000
# Set to true only behind HTTPS (for example behind a reverse proxy).
FORCE_SSL=false
DEFAULT_LOCALE=es
ENABLE_ACCOUNT_SIGNUP=false
APP_PORT=3000
# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=<generate-a-64-byte-hex-string>

# --- PostgreSQL (created by the stack) -----------------------------------
POSTGRES_DB=chatwoot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<strong-password>

# --- Redis (created by the stack) ----------------------------------------
REDIS_PASSWORD=<strong-password>

# --- MinIO / S3 storage (created by the stack) ---------------------------
MINIO_ROOT_USER=<minio-admin-user>
MINIO_ROOT_PASSWORD=<minio-admin-password, at least 8 characters>
MINIO_CONSOLE_PORT=9001
# Access key the app uses. minio-init creates this user with readwrite access to the bucket.
AWS_ACCESS_KEY_ID=<app-access-key>
AWS_SECRET_ACCESS_KEY=<app-secret-key, at least 8 characters>
AWS_REGION=us-east-1
S3_BUCKET_NAME=qeva-crm
# Public URL of MinIO's S3 API (browsers must reach it). Example: https://s3.example.com
# Leave the default only for a local test where you do not open attachments in a browser.
AWS_ENDPOINT=http://minio:9000

# --- Optional: email -----------------------------------------------------
MAILER_SENDER_EMAIL=QEVA CRM <no-reply@example.com>
SMTP_DOMAIN=example.com
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer
MAILER_INBOUND_EMAIL_DOMAIN=example.com
